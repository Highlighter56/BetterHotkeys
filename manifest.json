{
  "manifest_version": 3,
  "name": "Better Hotkeys",
  "description": "Keyboard shortcuts for common Chrome tab operations.",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "tabGroups",
    "windows"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Better Hotkeys",
    "default_popup": "pages/settings.html"
  },
  "options_ui": {
    "page": "pages/settings.html",
    "open_in_tab": true
  },
  "commands": {
	"_execute_action": {
		"suggested_key": {
			"default": "Alt+Shift+M"
		},
		"description": "Display Popup Menu"
	},
    "duplicate-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Duplicate"
    },
    "toggle-pin": {
      "description": "Pin/Unpin"
    },
    "group-tabs": {
      "description": "Group/Ungroup Tabs"
    },
    "highlight-right": {
      "description": "Highlight Right"
    },
    "highlight-left": {
      "description": "Highlight Left"
    },
    "cycle-next": {
      "suggested_key": {
        "default": "Alt+Period"
      },
      "description": "Activate Right"
    },
    "cycle-previous": {
      "suggested_key": {
        "default": "Alt+Comma"
      },
      "description": "Activate Left"
    },
    "move-next": {
      "description": "Move Tab(s) Right"
    },
    "move-previous": {
      "description": "Move Tab(s) Left"
    },
    "new-window": {
      "description": "Move Tab(s) to New Window"
    },
    "move-window-next": {
      "description": "Move Tab(s) to Next Window"
    },
    "move-window-previous": {
      "description": "Move Tab(s) to Previous Window"
    }
  }
}