{
  "manifest_version": 3,
  "name": "Better Hotkeys",
  "description": "Keyboard shortcuts for common Chrome tab operations.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "windows",
    "storage"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Better Hotkeys",
    "default_popup": "pages/settings.html"
  },
  "options_ui": {
    "page": "pages/settings.html",
    "open_in_tab": true
  },
  "commands": {
	"_execute_action": {
		"description": "Activate Extension"
	},
	"0_display-popup": {
	  "suggested_key": {
		"default": "Alt+Shift+M"
	  },
	  "description": "Display Popup"
	},
	"1_focus-chrome": {
	  "global": true,
	  "description": "Focus Chrome"
	},
    "2_duplicate-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Duplicate"
    },
	"3_new-window": {
		"suggested_key": {
		  "default": "Alt+N"
		},
	  "description": "Move Tab(s) to New Window"
	},
    "4_toggle-pin": {
      "description": "Pin/Unpin"
    },
    "5_group-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Group/Ungroup Tabs"
    },
    "6_toggle-group-collapse": {
      "description": "Expand/Collapse Group"
    },
	"7_cycle-next": {
	  "description": "Activate Right"
	},
	"8_cycle-previous": {
	  "description": "Activate Left"
	},
    "90_highlight-right": {
      "description": "Highlight Right"
    },
    "91_highlight-left": {
      "description": "Highlight Left"
    },
    "92_move-next": {
      "description": "Move Tab(s) Right"
    },
    "93_move-previous": {
      "description": "Move Tab(s) Left"
    },
    "94_move-window-next": {
      "description": "Move Tab(s) to Next Window"
    },
    "95_move-window-previous": {
      "description": "Move Tab(s) to Previous Window"
    }
  }
}
